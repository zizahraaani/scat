<!DOCTYPE html>
<html xmlns:v="urn:schemas-microsoft-com:vml"
      xmlns:o="urn:schemas-microsoft-com:office:office"
      xmlns:x="urn:schemas-microsoft-com:office:excel">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=Edge">
    <!--[if gte mso 9]>
    <xml>
        <o:DocumentProperties>
            <o:Author>PT Radiant Utama Interinsco, Tbk</o:Author>
            <o:Company>PT Radiant Utama Interinsco, Tbk</o:Company>
        </o:DocumentProperties>
        <o:OfficeDocumentSettings>
            <o:AllowPNG/>
            <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
    </xml>
    <xml>
        <x:ExcelWorkbook>
            <x:ExcelWorksheets>
                <x:ExcelWorksheet>
                    <x:Name>Incident Tracking</x:Name>
                    <x:WorksheetOptions>
                        <x:Print>
                            <x:ValidPrinterInfo/>
                            <x:HorizontalResolution>600</x:HorizontalResolution>
                            <x:VerticalResolution>600</x:VerticalResolution>
                        </x:Print>
                    </x:WorksheetOptions>
                </x:ExcelWorksheet>
            </x:ExcelWorksheets>
        </x:ExcelWorkbook>
    </xml>
    <![endif]-->
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 11pt;
            mso-font-charset: 0;
        }
        table {
            border-collapse: collapse;
            width: 100%;
            mso-table-lspace: 0pt;
            mso-table-rspace: 0pt;
        }
        th, td {
            border: 1px solid #000;
            padding: 6px 8px;
            vertical-align: middle;
            mso-border-alt: solid #000 .5pt;
        }
        th {
            background-color: #9dc3e6;
            text-align: center;
            font-weight: bold;
            mso-pattern: solid #9dc3e6;
        }
        .header-table td {
            border: none;
            mso-border-alt: none;
        }
        .title {
            font-size: 13pt;
            font-weight: bold;
            text-align: center;
            mso-style-textfill-fill-color: #000000;
        }
        .subtitle {
            font-size: 11pt;
            font-weight: bold;
            text-align: center;
        }
        .text-center {
            text-align: center;
        }
        .signature {
            margin-top: 50px;
        }
        .logo-cell {
            width: 80px;
            height: 80px;
            padding: 5px;
        }
    </style>
</head>

<body>

<!-- ================= HEADER ================= -->
<table class="header-table">
    <colgroup>
        <col width="5%">
        <col width="15%">
        <col width="5%">
        <col width="5%">
        <col width="35%">
        <col width="35%">
    </colgroup>
    <tr>
        <td></td>
        <td class="logo-cell" align="center" valign="middle">
                            <!-- Versi untuk Excel 2019/365 -->
                <img src="data:image/jpeg;base64," 
                     style="width:60px;height:60px;max-width:60px;max-height:60px;">
                
                <!-- Fallback untuk Office 365 -->
                <!--[if mso]>
                <v:shape xmlns:v="urn:schemas-microsoft-com:vml" id="logo1" style="width:60pt;height:60pt;visibility:visible;">
                    <v:imagedata src="data:image/jpeg;base64," o:title="Logo"/>
                </v:shape>
                <![endif]-->
                    </td>
        <td></td>
        <td></td>
        <td colspan="2" valign="middle">
            <div class="title">
                INCIDENT / ACCIDENT TRACKING & FOLLOW-UP STATUS RECORD
            </div>
            <div class="subtitle">
                PT RADIANT UTAMA INTERINSCO, TBK
            </div>
        </td>
    </tr>
</table>

<br>

<!-- ================= TABEL DATA ================= -->
<table>
<thead>
<tr>
    <th>No</th>
    <th>Incident Number</th>
    <th>Category</th>
    <th>Date</th>
    <th>Project</th>
    <th>Branch</th>
    <th>Recommendation</th>
    <th>Corrective Action</th>
    <th>PIC</th>
    <th>Status</th>
</tr>
</thead>
<tbody>

<tr>
    <td class="text-center">1</td>
    <td>123467890</td>
    <td>NEAR MISS</td>
    <td class="text-center">12/01/2025</td>
    <td>Gudang Penyimpanan Bahan Baku – Area Loading</td>
    <td>WAREHAUSE</td>
    <td>MELAKUKAN MEETING </td>
    <td>SELURUH KARYAWAN WAJIB MENGIKUTI MEETING </td>
    <td>RANI </td>
    <td class="text-center">Completed</td>
</tr>
<tr>
    <td class="text-center">2</td>
    <td>123467890</td>
    <td>NEAR MISS</td>
    <td class="text-center">12/01/2025</td>
    <td>Gudang Penyimpanan Bahan Baku – Area Loading</td>
    <td>WAREHAUSE</td>
    <td>MENINGKATKAN KESADARAN KESELAMATAN KERJA </td>
    <td>MEMBERI PERHATIAN DAN INFORMASI KEPADA KARYAWAN </td>
    <td>RANI </td>
    <td class="text-center">Pending</td>
</tr>

</tbody>
</table>

<!-- ================= FOOTER ================= -->
<div class="signature">
    <p>Jakarta, ................ 2026</p>
    <p>Dipersiapkan oleh,</p>
    <br><br>
    <p><strong>__________________________</strong></p>
    <p><strong>Investigator</strong></p>
</div>

</body>
</html>
